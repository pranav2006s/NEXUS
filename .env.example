# Export variables in your shell; .env is not automatically loaded.
# GITHUB_TOKEN=your_token_here
# GEMINI_API_KEY=use_a_key_from_a_free_tier_project_without_paid_billing
# AI is enabled by default. PRECEDENT_AI=0 explicitly disables cloud requests.
# PRECEDENT_SKIP=1  # Explicitly bypass only this tool's pre-push gate
# PRECEDENT_REPO_ROOTS=/absolute/trusted/repos
# PRECEDENT_CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:8000
# PRECEDENT_WEB_STATE=/absolute/persistent/state
# PRECEDENT_API_TOKEN=generate_at_least_32_random_characters
# PRECEDENT_BIND=127.0.0.1
# PRECEDENT_PORT=8000
# PRECEDENT_ALLOWED_HOSTS=localhost,127.0.0.1
